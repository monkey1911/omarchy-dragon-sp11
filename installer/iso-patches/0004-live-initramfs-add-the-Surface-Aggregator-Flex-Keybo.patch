From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kara Monk <monkey1911@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:42:52 -0700
Subject: [PATCH] live initramfs: add the Surface Aggregator (Flex Keyboard)
 modules

zzz-sp11-live.conf sorts after zz-aarch64-live.conf (which resets HOOKS and
filters MODULES) and appends the SAM modules. Staged for aarch64/snapdragon
media only; profiledef.sh gets a matching file_permissions entry.

Adapted from omarchy-dragon-sl7 (qBitnaut, MIT).
---
 builder/build-iso.sh               |  5 +++++
 configs/aarch64/zzz-sp11-live.conf | 10 ++++++++++
 configs/profiledef.sh              |  1 +
 3 files changed, 16 insertions(+)
 create mode 100644 configs/aarch64/zzz-sp11-live.conf

diff --git a/builder/build-iso.sh b/builder/build-iso.sh
index d0f623f..47032a8 100755
--- a/builder/build-iso.sh
+++ b/builder/build-iso.sh
@@ -175,6 +175,11 @@ if [[ $ISO_ARCH == aarch64 ]]; then
   fi
   install -Dm644 /configs/aarch64/zz-aarch64-live.conf \
     "$build_cache_dir/airootfs/etc/mkinitcpio.conf.d/zz-aarch64-live.conf"
+  if [[ $OMARCHY_MEDIA_TARGET == aarch64/snapdragon ]]; then
+    # Surface Pro 11 Flex Keyboard modules; must sort after zz-aarch64-live.conf.
+    install -Dm644 /configs/aarch64/zzz-sp11-live.conf \
+      "$build_cache_dir/airootfs/etc/mkinitcpio.conf.d/zzz-sp11-live.conf"
+  fi
   install -Dm644 /configs/aarch64/linux.preset \
     "$build_cache_dir/airootfs/etc/mkinitcpio.d/linux.preset"
   install -Dm755 /configs/aarch64/customize_airootfs.sh \
diff --git a/configs/aarch64/zzz-sp11-live.conf b/configs/aarch64/zzz-sp11-live.conf
new file mode 100644
index 0000000..016b1ab
--- /dev/null
+++ b/configs/aarch64/zzz-sp11-live.conf
@@ -0,0 +1,10 @@
+# Surface Pro 11 live initramfs: the Flex Keyboard is on the Surface
+# Aggregator Module (SAM), a serdev device that needs these modules before the
+# live root exists. Sorts after zz-aarch64-live.conf, which resets HOOKS and
+# filters MODULES. Every entry is optional ("?"): mkinitcpio skips a module the
+# kernel does not have. ath12k is deliberately absent: it probes before its
+# firmware is reachable in an initramfs and does not retry.
+MODULES+=(
+  surface_aggregator? surface_aggregator_registry? surface_aggregator_hub?
+  surface_hid_core? surface_hid? surface_kbd?
+)
diff --git a/configs/profiledef.sh b/configs/profiledef.sh
index 5e6a2f9..d4b50c1 100644
--- a/configs/profiledef.sh
+++ b/configs/profiledef.sh
@@ -66,6 +66,7 @@ file_permissions=(
 # Staged into the airootfs by build-iso.sh on aarch64 only.
 if [[ $arch == aarch64 ]]; then
   file_permissions["/etc/mkinitcpio.conf.d/zz-aarch64-live.conf"]="0:0:644"
+  file_permissions["/etc/mkinitcpio.conf.d/zzz-sp11-live.conf"]="0:0:644"
   file_permissions["/etc/mkinitcpio.d/linux.preset"]="0:0:644"
   file_permissions["/root/customize_airootfs.sh"]="0:0:755"
   file_permissions["/root/live-uki.sh"]="0:0:755"

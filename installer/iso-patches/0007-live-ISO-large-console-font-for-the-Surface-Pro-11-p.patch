From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kara Monk <monkey1911@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:43:31 -0700
Subject: [PATCH] live ISO: large console font for the Surface Pro 11 panel

The console on the 2880x1920 panel renders at the default 8x16 size. Install
/etc/vconsole.conf with FONT=ter-132b into the snapdragon live root;
systemd-vconsole-setup applies it at boot. terminus-font is already listed in
configs/packages.aarch64 (ALARM extra, arch=any).

Adapted from omarchy-dragon-sl7 (qBitnaut, MIT).
---
 builder/build-iso.sh          | 5 +++++
 configs/aarch64/vconsole.conf | 3 +++
 2 files changed, 8 insertions(+)
 create mode 100644 configs/aarch64/vconsole.conf

diff --git a/builder/build-iso.sh b/builder/build-iso.sh
index 47032a8..15fc46e 100755
--- a/builder/build-iso.sh
+++ b/builder/build-iso.sh
@@ -173,6 +173,11 @@ if [[ $ISO_ARCH == aarch64 ]]; then
     ln -s ../omarchy-live-dsp.service \
       "$build_cache_dir/airootfs/etc/systemd/system/multi-user.target.wants/omarchy-live-dsp.service"
   fi
+  if [[ $OMARCHY_MEDIA_TARGET == aarch64/snapdragon ]]; then
+    # 2880x1920 Surface Pro 11 panel: the default console font is unreadably small.
+    install -Dm644 /configs/aarch64/vconsole.conf \
+      "$build_cache_dir/airootfs/etc/vconsole.conf"
+  fi
   install -Dm644 /configs/aarch64/zz-aarch64-live.conf \
     "$build_cache_dir/airootfs/etc/mkinitcpio.conf.d/zz-aarch64-live.conf"
   if [[ $OMARCHY_MEDIA_TARGET == aarch64/snapdragon ]]; then
diff --git a/configs/aarch64/vconsole.conf b/configs/aarch64/vconsole.conf
new file mode 100644
index 0000000..a5d7688
--- /dev/null
+++ b/configs/aarch64/vconsole.conf
@@ -0,0 +1,3 @@
+# terminus-font is in packages.aarch64; ter-132b is 16x32, legible on the
+# 2880x1920 Surface Pro 11 panel.
+FONT=ter-132b

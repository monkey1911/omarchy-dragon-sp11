From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kara Monk <monkey1911@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:42:11 -0700
Subject: [PATCH] architecture.sh: Snapdragon live media uses linux-sp11

ISO_KERNEL feeds the live package list (build-iso.sh) and the GRUB
kernel/initramfs names. Generic media and x86 are unchanged.

Adapted from omarchy-dragon-sl7 (qBitnaut, MIT).
---
 builder/architecture.sh | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/builder/architecture.sh b/builder/architecture.sh
index 6586e1e..65e06b0 100644
--- a/builder/architecture.sh
+++ b/builder/architecture.sh
@@ -34,6 +34,13 @@ case "$OMARCHY_ARCH:$OMARCHY_MEDIA_TARGET" in
     ;;
 esac
 
+# Surface Pro 11 (omarchy-dragon-sp11): the Snapdragon live media boots linux-sp11
+# (dwhinham/linux-sp11) from the local [omarchy-sp11] repository. Generic media
+# keeps ALARM's.
+if [[ $OMARCHY_ARCH:$OMARCHY_MEDIA_TARGET == aarch64:aarch64/snapdragon ]]; then
+  ISO_KERNEL=linux-sp11
+fi
+
 ISO_ARCH=$OMARCHY_ARCH
 OMARCHY_ISO_NAME=omarchy
 if [[ $OMARCHY_MEDIA_TARGET == aarch64/generic ]]; then

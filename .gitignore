# NEVER commit Microsoft or Qualcomm firmware, drivers, or device captures.
# Firmware is copied from Windows (or Microsoft's driver packages) on the
# target machine at install time and is never redistributed here.

# Firmware / driver artifacts
*.msi
*.cab
*.mbn
*.elf
*.jsn
*.sys
*.cat
*.inf
*.zip
firmware/
extracted/
drivers/

# Build outputs
out/
work/
build/
*.iso
*.img
*.pkg.tar.*
src/
pkg/

# makepkg-downloaded sources
pkgs/*/*.tar.gz
__pycache__/
*.pyc

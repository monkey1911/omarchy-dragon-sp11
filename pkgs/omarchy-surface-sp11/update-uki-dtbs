#!/bin/bash
# Install linux-sp11's Surface Pro 11 device trees where Omarchy looks for
# them, and make the unified kernel image list them.
#
# linux-sp11 keeps its device trees in /usr/lib/modules/<kver>/dtb/qcom (it
# writes nothing to /boot). Omarchy's qualcomm/dtb-uki.sh globs
# /boot/dtbs/qcom, which holds the stock linux-aarch64 trees. So:
#   1. copy the newest linux-sp11 denali device trees over the ones in
#      /boot/dtbs/qcom (the original is kept once as <name>.dtb.alarm-orig,
#      which the *.dtb glob ignores);
#   2. write the DeviceTreeAuto block in /etc/kernel/uki.conf with the same
#      markers as dtb-uki.sh. systemd-stub then picks the tree from SMBIOS
#      data: systemd's hardware-ID table maps the Surface Pro 11 to
#      "microsoft,denali-oled" (x1e80100-microsoft-denali-oled.dtb).
#
# LCD models (Snapdragon X Plus, x1p64100-microsoft-denali.dtb) share the
# SMBIOS identity, so systemd-stub would still pick the OLED tree for them.
# That case is not handled yet; this script warns when it detects an X Plus.
#
# Run by 85-omarchy-surface-sp11-dtbs.hook after linux-sp11, linux-sp11-dtbs
# or linux-aarch64 installs/upgrades. Usage: update-uki-dtbs [--print]
#
# Adapted from omarchy-surface-sl7's update-uki-dtbs (qBitnaut, MIT).
set -euo pipefail

modules_root=${OMARCHY_SP11_MODULES_DIR:-/usr/lib/modules}
uki_config=${OMARCHY_QUALCOMM_UKI_CONFIG:-/etc/kernel/uki.conf}
boot_dtb_dir=${OMARCHY_QUALCOMM_DTB_DIR:-/boot/dtbs/qcom}
boards=(x1e80100-microsoft-denali-oled x1p64100-microsoft-denali)
managed_begin="# BEGIN OMARCHY QUALCOMM DEVICE TREES"
managed_end="# END OMARCHY QUALCOMM DEVICE TREES"

print_only=0
case ${1:-} in
  --print) print_only=1 ;;
  "") ;;
  *)
    echo "usage: ${0##*/} [--print]" >&2
    exit 2
    ;;
esac

# linux-sp11 installs into dtb/; accept dtbs/ too in case that ever changes.
kernel_dtb_dir() { # kernel module directory
  local d
  for d in "$1/dtb/qcom" "$1/dtbs/qcom"; do
    [[ -f $d/${boards[0]}.dtb ]] && { echo "$d"; return 0; }
  done
  return 1
}

# Newest installed kernel that belongs to linux-sp11.
kvers=()
for dir in "$modules_root"/*/; do
  dir=${dir%/}
  if [[ -f $dir/pkgbase && $(<"$dir/pkgbase") == linux-sp11 ]] && kernel_dtb_dir "$dir" >/dev/null; then
    kvers+=("${dir##*/}")
  fi
done
if ((${#kvers[@]} == 0)); then
  echo "omarchy-surface-sp11: no linux-sp11 device trees under $modules_root; UKI config unchanged" >&2
  exit 0
fi
kver=$(printf '%s\n' "${kvers[@]}" | sort -V | tail -n 1)
src_dir=$(kernel_dtb_dir "$modules_root/$kver")

if ((!print_only)); then
  mkdir -p "$boot_dtb_dir"
  for board in "${boards[@]}"; do
    src=$src_dir/$board.dtb
    dst=$boot_dtb_dir/$board.dtb
    [[ -f $src ]] || continue
    if [[ -f $dst ]] && ! cmp -s "$src" "$dst"; then
      [[ -e $dst.alarm-orig ]] || cp -p "$dst" "$dst.alarm-orig"
    fi
    cmp -s "$src" "$dst" 2>/dev/null || install -m644 "$src" "$dst"
  done
fi

dtbs=()
for board in "${boards[@]}"; do
  if ((print_only)); then dtb=$src_dir/$board.dtb; else dtb=$boot_dtb_dir/$board.dtb; fi
  [[ -f $dtb ]] && dtbs+=("$dtb")
done

# Existing config minus our (or dtb-uki.sh's) previous block.
rest=""
if [[ -f $uki_config ]]; then
  rest=$(awk -v begin="$managed_begin" -v end="$managed_end" '
    $0 == begin { managed = 1; next }
    managed && $0 == end { managed = 0; next }
    !managed { print }
  ' "$uki_config")
fi

# A second [UKI] header may be rejected by ukify's config parser; only emit
# one when the file does not already end inside a [UKI] section.
last_section=$(grep -E '^\[.*\]$' <<<"$rest" | tail -n 1 || true)
header="[UKI]"
[[ $last_section == "[UKI]" ]] && header=""

block=$(
  echo "$managed_begin"
  echo "# Generated by omarchy-surface-sp11 (denali device trees from linux-sp11 $kver)."
  echo "# systemd-stub selects a device tree from SMBIOS data."
  [[ -n $header ]] && echo "$header"
  echo "DeviceTreeAuto=${dtbs[*]}"
  echo "$managed_end"
)

if ((print_only)); then
  echo "$block"
  exit 0
fi

mkdir -p "$(dirname "$uki_config")"
uki_tmp=$(mktemp "${uki_config}.XXXXXX")
trap 'rm -f "$uki_tmp"' EXIT

[[ -n $rest ]] && echo "$rest" >"$uki_tmp"
echo "$block" >>"$uki_tmp"
chmod 0644 "$uki_tmp"
mv -f "$uki_tmp" "$uki_config"
trap - EXIT
echo "omarchy-surface-sp11: ${#dtbs[@]} device trees from linux-sp11 $kver listed in $uki_config"

# Snapdragon X Plus = LCD model: systemd-stub will still choose the OLED tree.
if command -v dmidecode >/dev/null 2>&1 &&
  dmidecode -s processor-version 2>/dev/null | grep -qi 'X1P'; then
  echo "omarchy-surface-sp11: WARNING: this looks like a Snapdragon X Plus (LCD) Surface Pro 11." >&2
  echo "  The boot image selects the OLED device tree for every Surface Pro 11; the LCD" >&2
  echo "  model is not handled yet. See the omarchy-dragon-sp11 README." >&2
fi
